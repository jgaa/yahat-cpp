@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost @USE_BOOST_VERSION@ COMPONENTS
    program_options coroutine context chrono json url)
find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@.cmake")

# Create additional alias to match the exact requirement yahat-cpp::yahat-cpp
if(TARGET yahat-cpp::yahat AND NOT TARGET yahat-cpp::yahat-cpp)
  add_library(yahat-cpp::yahat-cpp ALIAS yahat-cpp::yahat)
endif()
